# ── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── AI routing (Clawbot hybrid pattern) ──────────────────
AI_PRIMARY=ollama                 # ollama | claude
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:235b            # default
OLLAMA_MODEL_EXTRACT=qwen3:235b    # strict-JSON extraction + selector healing
OLLAMA_MODEL_DIFF=deepseek-v3      # semantic diff (reasoning)
OLLAMA_MODEL_DRAFT=deepseek-v3     # newsjack drafts (prose)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ── Ops ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=               # reuse Clawbot bot or a dedicated one
TELEGRAM_CHAT_ID=
HEALTHCHECK_URL=                  # https://hc-ping.com/xxxx (dead-man's switch)
NETLIFY_BUILD_HOOK=               # rebuild history pages after changes
NEWSJACK_THRESHOLD=80
