# ── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── AI routing via estate LiteLLM (WSL on CLAW). CHEAPEST-FIRST: free local GPU ──
# models first, then cheap cloud (Qwen3-235B-A22B-Thinking → DeepSeek flash). No paid
# Claude lane in the auto-loop (MONEY RULE). Cascades are comma-separated model_names.
LITELLM_BASE_URL=http://192.168.1.7:4000   # CLAW WSL LiteLLM, listens on 0.0.0.0
LITELLM_API_KEY=                            # LITELLM_MASTER_KEY from /root/agentic/.env
FP_MODELS_EXTRACT=local-worker-large,local-worker,qwen3-flash-thinking,deepseek-flash
FP_MODELS_DIFF=local-worker-large,qwen3-flash-thinking,deepseek-flash
FP_MODELS_DRAFT=local-worker-large,qwen3-flash-thinking,deepseek-flash
FP_MODELS_VISION=local-vision,fusion-vision

# ── Ops ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=               # reuse Clawbot bot or a dedicated one
TELEGRAM_CHAT_ID=
HEALTHCHECK_URL=                  # https://hc-ping.com/xxxx (dead-man's switch)
NETLIFY_BUILD_HOOK=               # rebuild history pages after changes
NEWSJACK_THRESHOLD=80
