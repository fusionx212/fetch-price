---
// Core molecule — a vendor row for lists (history index, category pages, feed).
import type { Vendor, Plan, PricePoint } from '../lib/types';
import { priceLabel, deltaChip } from '../lib/format';
import Sparkline from './Sparkline.astro';
interface Props {
  vendor: Vendor;
  plan?: Plan | null;
  points?: PricePoint[];
  highlight?: boolean;
  fresh?: string;
}
const { vendor, plan, points = [], highlight = false, fresh } = Astro.props;
const first = points.map((p) => p.price).find((x) => typeof x === 'number');
const last = [...points].reverse().map((p) => p.price).find((x) => typeof x === 'number');
const d = deltaChip(first, last);
---
<a href={`/pricing-history/${vendor.slug}/`} class={`vrow${highlight ? ' vrow-best' : ''}`}>
  <span class="vrow-main">
    <span class="vrow-name">{vendor.name}</span>
    {plan && <span class="label vrow-plan">{plan.name}</span>}
    <span class="label vrow-cat">{vendor.category}</span>
  </span>
  <span class="vrow-spark"><Sparkline points={points} w={110} h={30} /></span>
  {d ? <span class={`chip chip-${d.dir}`}>{d.text}</span> : <span class="chip chip-flat">—</span>}
  <span class="data vrow-price">{plan ? priceLabel(plan) : ''}</span>
  {fresh && <span class="fresh vrow-fresh"><span class="dot"></span>{fresh}</span>}
</a>
<style>
  .vrow{display:grid; grid-template-columns:minmax(0,1fr) auto auto auto; align-items:center; gap:16px; padding:14px 12px; border-radius:10px; border:1px solid transparent}
  .vrow + .vrow{border-top:1px solid var(--color-hairline)}
  .vrow:hover{background:var(--color-surface-high)}
  .vrow-best{background:var(--color-accent-container)}
  .vrow-main{display:flex; align-items:baseline; gap:10px; flex-wrap:wrap; min-width:0}
  .vrow-name{font-weight:600; color:var(--color-ink); font-size:1.05rem}
  .vrow-cat{color:var(--color-ink-3)}
  .vrow-price{font-size:1.1rem; text-align:right; min-width:110px}
  .vrow-fresh{grid-column:1/-1; margin-top:-4px}
  @media (max-width:640px){
    .vrow{grid-template-columns:1fr auto; gap:8px}
    .vrow-spark{display:none}
    .vrow-fresh{display:none}
  }
</style>
