---
import '../styles/global.css';
import TheWire from '../components/TheWire.astro';
import { getChangeEvents } from '../lib/data';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  path?: string;
  jsonLd?: object | object[];
  showWire?: boolean;
}
const { title, description, path = '', jsonLd, showWire = true } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') || 'https://fetch-price.com';
const canonical = `${site}/${path}`.replace(/([^:]\/)\/+/g, '$1');
const wireEvents = showWire ? await getChangeEvents(14) : [];
const siteSchemas = [
  {
    '@context': 'https://schema.org', '@type': 'Organization',
    name: 'Fetch-Price', url: site,
    description: 'Live pricing and deal tracking for the business software UK SMEs pay for. Track price rises, find a better deal.',
  },
  {
    '@context': 'https://schema.org', '@type': 'WebSite',
    name: 'Fetch-Price', url: site,
  },
];
const ld = [...siteSchemas, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Fetch-Price" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#f7f3ec" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Geist:wght@400;500;600&family=Geist+Mono:wght@500&display=swap" rel="stylesheet" />
  {ld.map((obj) => (
    <script type="application/ld+json" set:html={JSON.stringify(obj)} />
  ))}
</head>
<body>
  <header class="site-head">
    <div class="wrap head-inner">
      <a href="/" class="brand" aria-label="Fetch-Price home">
        <span class="brand-mark">Fetch</span><span class="brand-mark2">Price</span>
      </a>
      <nav class="nav">
        <a href="/pricing-history/">Price histories</a>
        <a href="/best/">Buying guides</a>
        <a href="/alerts/">Recent changes</a>
        <a href="/#how">How it works</a>
        <a href="/#watch" class="btn btn-secondary nav-cta">Watch my stack</a>
      </nav>
    </div>
  </header>
  {showWire && wireEvents.length > 0 && <TheWire events={wireEvents} />}

  <main>
    <slot />
  </main>

  <footer class="site-foot">
    <div class="wrap foot-inner">
      <div>
        <div class="brand foot-brand"><span class="brand-mark">Fetch</span><span class="brand-mark2">Price</span></div>
        <p class="foot-tag">Track your business software prices. Catch every rise. Find a better deal.</p>
      </div>
      <nav class="foot-links">
        <a href="/pricing-history/">Price histories</a>
        <a href="/best/">Buying guides</a>
        <a href="/alerts/">Recent changes</a>
        <a href="/#how">How it works</a>
        <a href="/#watch">Watch your stack</a>
      </nav>
    </div>
    <div class="wrap foot-legal">
      <span class="mono">© 2026 Fetch-Price</span>
      <span class="foot-disc">Prices shown are the vendors’ published list prices, updated regularly and shown inclusive where the vendor states VAT. Independent — not affiliated with the vendors listed.</span>
    </div>
  </footer>

  <style>
    .site-head{position:sticky; top:0; z-index:20; background:color-mix(in srgb, var(--color-paper) 88%, transparent); backdrop-filter:saturate(1.2) blur(6px); border-bottom:1px solid var(--color-hairline)}
    .head-inner{display:flex; align-items:center; justify-content:space-between; height:64px}
    .brand{font-family:var(--font-display); font-weight:600; font-size:1.375rem; letter-spacing:-.02em; color:var(--color-ink)}
    .brand-mark2{color:var(--color-accent)}
    .nav{display:flex; align-items:center; gap:26px}
    .nav a{font-size:.95rem; font-weight:500; color:var(--color-ink-2)}
    .nav a:hover{color:var(--color-ink)}
    .nav-cta{padding:8px 14px; font-size:.9rem}
    @media (max-width:720px){ .nav a:not(.nav-cta){display:none} }

    .site-foot{border-top:1px solid var(--color-hairline); background:var(--color-surface-lowest); margin-top:96px; padding-block:48px 28px}
    .foot-inner{display:flex; justify-content:space-between; gap:40px; flex-wrap:wrap; padding-bottom:28px}
    .foot-brand{font-size:1.5rem}
    .foot-tag{margin-top:8px; color:var(--color-ink-3); max-width:38ch}
    .foot-links{display:flex; flex-direction:column; gap:10px}
    .foot-links a{color:var(--color-ink-2); font-size:.95rem}
    .foot-legal{display:flex; gap:16px; align-items:baseline; flex-wrap:wrap; padding-top:22px; border-top:1px solid var(--color-hairline); color:var(--color-ink-3); font-size:.82rem}
    .foot-disc{max-width:70ch; line-height:1.5}
  </style>
</body>
</html>
